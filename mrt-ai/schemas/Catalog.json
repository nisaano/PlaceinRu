{
  "$defs": {
    "Region": {
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "scores": {
          "additionalProperties": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Scores",
          "type": "object"
        },
        "month_scores": {
          "additionalProperties": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Month Scores",
          "type": "object"
        },
        "trip_days_min": {
          "maximum": 90,
          "minimum": 1,
          "title": "Trip Days Min",
          "type": "integer"
        },
        "trip_days_max": {
          "maximum": 90,
          "minimum": 1,
          "title": "Trip Days Max",
          "type": "integer"
        },
        "car_required": {
          "enum": [
            "required",
            "preferred",
            "not_required"
          ],
          "title": "Car Required",
          "type": "string"
        },
        "budget_level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Budget Level",
          "type": "integer"
        },
        "year_round": {
          "title": "Year Round",
          "type": "boolean"
        },
        "has_sea": {
          "title": "Has Sea",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "region_id",
        "code",
        "slug",
        "name",
        "aliases",
        "description",
        "tags",
        "scores",
        "month_scores",
        "trip_days_min",
        "trip_days_max",
        "car_required",
        "budget_level",
        "year_round",
        "has_sea",
        "source"
      ],
      "title": "Region",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_lines": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Source Lines",
          "type": "object"
        },
        "data_mode": {
          "enum": [
            "manual",
            "fixture",
            "cached",
            "live"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "verification": {
          "enum": [
            "user_supplied_unverified",
            "synthetic",
            "provider_reported"
          ],
          "title": "Verification",
          "type": "string"
        },
        "license_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Reference"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        }
      },
      "required": [
        "provider",
        "data_mode",
        "verification",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "normalizer_version": {
      "title": "Normalizer Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/Region"
      },
      "title": "Regions",
      "type": "array"
    }
  },
  "required": [
    "normalizer_version",
    "snapshot_id",
    "regions"
  ],
  "title": "Catalog",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
