{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "REGION",
            "HOTEL",
            "TRANSPORT",
            "ATTRACTION",
            "RESTAURANT",
            "ACTIVITY",
            "GUIDE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opening_hours": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening Hours"
        },
        "visit_duration_minutes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Duration Minutes"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "object_id",
        "kind",
        "region_id",
        "name",
        "description",
        "source"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_lines": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Source Lines",
          "type": "object"
        },
        "data_mode": {
          "enum": [
            "manual",
            "fixture",
            "cached",
            "live"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "verification": {
          "enum": [
            "user_supplied_unverified",
            "synthetic",
            "provider_reported"
          ],
          "title": "Verification",
          "type": "string"
        },
        "license_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Reference"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        }
      },
      "required": [
        "provider",
        "data_mode",
        "verification",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "data_mode": {
      "const": "fixture",
      "title": "Data Mode",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "coordinate_notice": {
      "title": "Coordinate Notice",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "data_mode",
    "description",
    "coordinate_notice",
    "candidates"
  ],
  "title": "FixturePlaceCatalog",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
