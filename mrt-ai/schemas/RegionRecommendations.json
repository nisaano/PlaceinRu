{
  "$defs": {
    "RegionOption": {
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Components",
          "type": "object"
        },
        "matched_interests": {
          "items": {
            "type": "string"
          },
          "title": "Matched Interests",
          "type": "array"
        },
        "unmatched_interests": {
          "items": {
            "type": "string"
          },
          "title": "Unmatched Interests",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "budget_status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Budget Status",
          "type": "string"
        },
        "total_price_minor": {
          "default": null,
          "title": "Total Price Minor",
          "type": "null"
        }
      },
      "required": [
        "region_id",
        "name",
        "description",
        "score",
        "score_components",
        "matched_interests",
        "unmatched_interests",
        "reasons",
        "warnings",
        "source"
      ],
      "title": "RegionOption",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_lines": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Source Lines",
          "type": "object"
        },
        "data_mode": {
          "enum": [
            "manual",
            "fixture",
            "cached",
            "live"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "verification": {
          "enum": [
            "user_supplied_unverified",
            "synthetic",
            "provider_reported"
          ],
          "title": "Verification",
          "type": "string"
        },
        "license_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Reference"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        }
      },
      "required": [
        "provider",
        "data_mode",
        "verification",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "needs_parameters",
        "partial",
        "no_matches",
        "outside_coverage",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "catalog_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Snapshot Id"
    },
    "based_on_state_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Based On State Version"
    },
    "ranking_version": {
      "default": "region-rules-v1",
      "title": "Ranking Version",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/RegionOption"
      },
      "title": "Options",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "missing_parameters": {
      "items": {
        "type": "string"
      },
      "title": "Missing Parameters",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "RegionRecommendations",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
