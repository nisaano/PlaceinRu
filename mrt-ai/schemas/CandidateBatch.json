{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "REGION",
            "HOTEL",
            "TRANSPORT",
            "ATTRACTION",
            "RESTAURANT",
            "ACTIVITY",
            "GUIDE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opening_hours": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening Hours"
        },
        "visit_duration_minutes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Duration Minutes"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "object_id",
        "kind",
        "region_id",
        "name",
        "description",
        "source"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "title": "Offer Id",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "query_fingerprint": {
          "title": "Query Fingerprint",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "manual",
            "fixture",
            "cached",
            "live"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "availability": {
          "default": "unknown",
          "enum": [
            "available",
            "unavailable",
            "unknown",
            "on_request"
          ],
          "title": "Availability",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Price"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "booking_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Booking Url"
        },
        "booking_link_type": {
          "anyOf": [
            {
              "enum": [
                "offer",
                "search",
                "inquiry"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Booking Link Type"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "offer_id",
        "object_id",
        "query_fingerprint",
        "data_mode"
      ],
      "title": "Offer",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "RUB",
          "default": "RUB",
          "title": "Currency",
          "type": "string"
        },
        "basis": {
          "enum": [
            "person",
            "group",
            "room_night",
            "stay",
            "leg"
          ],
          "title": "Basis",
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "taxes_included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxes Included"
        },
        "fees_included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fees Included"
        },
        "status": {
          "enum": [
            "quoted",
            "estimated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "basis",
        "quantity",
        "status"
      ],
      "title": "Price",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_lines": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Source Lines",
          "type": "object"
        },
        "data_mode": {
          "enum": [
            "manual",
            "fixture",
            "cached",
            "live"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "verification": {
          "enum": [
            "user_supplied_unverified",
            "synthetic",
            "provider_reported"
          ],
          "title": "Verification",
          "type": "string"
        },
        "license_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Reference"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        }
      },
      "required": [
        "provider",
        "data_mode",
        "verification",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "manual",
        "fixture",
        "cached",
        "live"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "status": {
      "enum": [
        "partial",
        "no_candidates",
        "outside_coverage"
      ],
      "title": "Status",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "query_fingerprint": {
      "title": "Query Fingerprint",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "offers": {
      "items": {
        "$ref": "#/$defs/Offer"
      },
      "title": "Offers",
      "type": "array"
    },
    "unavailable_kinds": {
      "items": {
        "enum": [
          "REGION",
          "HOTEL",
          "TRANSPORT",
          "ATTRACTION",
          "RESTAURANT",
          "ACTIVITY",
          "GUIDE"
        ],
        "type": "string"
      },
      "title": "Unavailable Kinds",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "provider",
    "data_mode",
    "status",
    "snapshot_id",
    "query_fingerprint"
  ],
  "title": "CandidateBatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
